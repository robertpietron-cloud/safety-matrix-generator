<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="TwoOfTwo" Class="Safety" Revision="1.0">
<Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true"/><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true"/><Parameter Name="In1" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true"/><Parameter Name="In2" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true"/><Parameter Name="Out" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true"/></Parameters>
<LocalTags><LocalTag Name="Both" DataType="BOOL" Radix="Decimal"/></LocalTags>
<Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[XIC(In1)XIC(In2)OTE(Both);]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[XIC(Both)OTE(Out);]]></Text></Rung></RLLContent></Routine></Routines>
</AddOnInstructionDefinition>
