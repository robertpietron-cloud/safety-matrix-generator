<Tags><Tag Name="Std_ToSafety" TagType="Base" DataType="DINT" Dimensions="2" Class="Standard" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Standard -> safety bits]]></Description><Comments><Comment Operand="[0].0"><![CDATA[Reset push button -S9 (control desk)]]></Comment><Comment Operand="[0].2"><![CDATA[Infeed override from HMI]]></Comment><Comment Operand="[0].3"><![CDATA[Infeed muting request]]></Comment><Comment Operand="[0].4"><![CDATA[Guard lock release request]]></Comment><Comment Operand="[0].5"><![CDATA[Guard lock release by sequence]]></Comment></Comments><Data Format="L5K"><![CDATA[[0,0]]]></Data></Tag><Tag Name="Safety_FromStd" TagType="Base" DataType="DINT" Dimensions="2" Class="Safety" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[[0,0]]]></Data></Tag><Tag Name="Safety_ToStd" TagType="Base" DataType="DINT" Dimensions="2" Class="Safety" Radix="Decimal" ExternalAccess="Read/Write"><Comments><Comment Operand="[0].0"><![CDATA[Robot zone safe]]></Comment><Comment Operand="[0].5"><![CDATA[Spare switch status]]></Comment></Comments><Data Format="L5K"><![CDATA[[0,0]]]></Data></Tag><Tag Name="Reset_PB" TagType="Base" DataType="BOOL" Class="Standard" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Reset push button -S9]]></Description><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="HMI_Infeed_Override" TagType="Base" DataType="BOOL" Class="Standard" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Muting_Request" TagType="Base" DataType="BOOL" Class="Standard" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Unlock_Request" TagType="Base" DataType="BOOL" Class="Standard" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Seq_Unlock" TagType="Base" DataType="BOOL" Class="Standard" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag></Tags>
<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags></Tags>
<Routines>
<Routine Name="MainRoutine" Type="RLL"><RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Bits to the safety task (SafetyTagMap source)]]></Comment><Text><![CDATA[XIC(Reset_PB)OTE(Std_ToSafety[0].0);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[XIC(HMI_Infeed_Override)OTE(Std_ToSafety[0].2);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[XIC(Muting_Request)OTE(Std_ToSafety[0].3);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[XIC(Unlock_Request)OTE(Std_ToSafety[0].4);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[XIC(Seq_Unlock)OTL(Std_ToSafety[0].5);]]></Text></Rung>
</RLLContent></Routine>
</Routines></Program>
<Program Name="SafetyProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" Class="Safety" UseAsFolder="false">
<Tags><Tag Name="EStop_Panel" TagType="Base" DataType="EMERGENCY_STOP" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[E-stop control panel -S1]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="EStop_Robot" TagType="Base" DataType="EMERGENCY_STOP" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[E-stop robot cell -S2]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="EStop_Spare" TagType="Base" DataType="EMERGENCY_STOP" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Spare E-stop (not wired)]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="Door_Robot" TagType="Base" DataType="DCI_STOP" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Robot cell door -B10]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="Gate_Infeed" TagType="Base" DataType="REDUNDANT_INPUT" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Infeed gate -B30]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="LC_Infeed" TagType="Base" DataType="LIGHT_CURTAIN" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Infeed light curtain -F40]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="Switch_Unused" TagType="Base" DataType="REDUNDANT_INPUT" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Spare position switch]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="Door_Press" TagType="Base" DataType="REDUNDANT_INPUT" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Press door -B50]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="K1K2_Main" TagType="Base" DataType="REDUNDANT_OUTPUT" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Main contactors -K1/-K2]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="Valve_Press" TagType="Base" DataType="CONFIGURABLE_ROUT" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Press safety valve -Y1/-Y2]]></Description><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="Press_SS1" TagType="Base" DataType="TIMER" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[[0,2000,0]]]></Data></Tag><Tag Name="TwoOfTwo_1" TagType="Base" DataType="TwoOfTwo" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[[0]]]></Data></Tag><Tag Name="Reset_Storage" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Reset_Edge" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="K1K2_Reset" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Mute_Infeed" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Zone_Robot_OK" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Robot zone permissive]]></Description><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Zone_Infeed_OK" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Infeed zone permissive]]></Description><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Zone_Press_OK" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Press zone permissive]]></Description><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Cell_OK" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Press_Mode" TagType="Base" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Maintenance_Jumper" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Left from commissioning]]></Description><Data Format="L5K"><![CDATA[1]]></Data></Tag><Tag Name="Spare_Bit" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag><Tag Name="Old_Unused" TagType="Base" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write"><Data Format="L5K"><![CDATA[0]]></Data></Tag></Tags>
<Routines>
<Routine Name="Inputs" Type="RLL"><RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Reset from the control desk (standard push button via SafetyTagMap)]]></Comment><Text><![CDATA[XIC(Safety_FromStd[0].0)OSR(Reset_Storage,Reset_Edge);]]></Text></Rung>
<Rung Number="1" Type="N"><Comment><![CDATA[E-stop control panel]]></Comment><Text><![CDATA[ESTOP(EStop_Panel,MANUAL,Local:1:I.Pt00Data,Local:1:I.Pt01Data,Reset_Edge,Reset_Edge);]]></Text></Rung>
<Rung Number="2" Type="N"><Comment><![CDATA[E-stop robot cell]]></Comment><Text><![CDATA[ESTOP(EStop_Robot,AUTOMATIC,Local:1:I.Pt02Data,Local:1:I.Pt03Data,Reset_Edge,Reset_Edge);]]></Text></Rung>
<Rung Number="3" Type="N"><Comment><![CDATA[Spare E-stop - not wired yet]]></Comment><Text><![CDATA[ESTOP(EStop_Spare,MANUAL,1,1,Reset_Edge,Reset_Edge);]]></Text></Rung>
<Rung Number="4" Type="N"><Comment><![CDATA[Robot cell door]]></Comment><Text><![CDATA[DCS(Door_Robot,DOOR_MONITORING,EQUIVALENT_ACTIVE_HIGH,500,MANUAL,MANUAL,Local:1:I.Pt04Data,Local:1:I.Pt05Data,1,Reset_Edge);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[RIN(Gate_Infeed,MANUAL,Remote_IO:1:I.Pt00Data,Remote_IO:1:I.Pt00Data,Reset_Edge,Reset_Edge);]]></Text></Rung>
<Rung Number="6" Type="N"><Text><![CDATA[XIC(Safety_FromStd[0].3)OTE(Mute_Infeed);]]></Text></Rung>
<Rung Number="7" Type="N"><Text><![CDATA[LC(LC_Infeed,MANUAL,Remote_IO:1:I.Pt02Data,Remote_IO:1:I.Pt03Data,20,Mute_Infeed,Reset_Edge,Reset_Edge);]]></Text></Rung>
<Rung Number="8" Type="N"><Text><![CDATA[RIN(Switch_Unused,MANUAL,Remote_IO:1:I.Pt06Data,Remote_IO:1:I.Pt07Data,Reset_Edge,Reset_Edge);]]></Text></Rung>
<Rung Number="9" Type="N"><Text><![CDATA[[XIC(Switch_Unused.O1) ,XIC(Maintenance_Jumper) ]OTE(Safety_ToStd[0].5);]]></Text></Rung>
<Rung Number="10" Type="N"><Text><![CDATA[RIN(Door_Press,MANUAL,Remote_IO:1:I.Pt04Data,Remote_IO:1:I.Pt05Data,Reset_Edge,Reset_Edge);]]></Text></Rung>
<Rung Number="11" Type="N"><Comment><![CDATA[Zone permissives]]></Comment><Text><![CDATA[XIC(EStop_Panel.O1)XIC(EStop_Robot.O1)XIC(Door_Robot.O1)XIC(EStop_Spare.O1)OTE(Zone_Robot_OK);]]></Text></Rung>
<Rung Number="12" Type="N"><Text><![CDATA[[XIC(LC_Infeed.O1) ,XIC(Safety_FromStd[0].2) ]XIC(Gate_Infeed.O1)XIC(EStop_Panel.O1)OTE(Zone_Infeed_OK);]]></Text></Rung>
<Rung Number="13" Type="N"><Text><![CDATA[XIC(EStop_Panel.O1)[XIC(Door_Press.O1) ,EQU(Press_Mode,2) ]OTE(Zone_Press_OK);]]></Text></Rung>
<Rung Number="14" Type="N"><Text><![CDATA[TwoOfTwo(TwoOfTwo_1,Zone_Robot_OK,Zone_Infeed_OK,Cell_OK);]]></Text></Rung>
<Rung Number="15" Type="N"><Text><![CDATA[AFI()OTE(Spare_Bit);]]></Text></Rung>
</RLLContent></Routine>
<Routine Name="MainRoutine" Type="RLL"><RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[JSR(Inputs,0);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[JSR(Outputs,0);]]></Text></Rung>
</RLLContent></Routine>
<Routine Name="Outputs" Type="RLL"><RLLContent>
<Rung Number="0" Type="N"><Comment><![CDATA[Main contactors -K1/-K2]]></Comment><Text><![CDATA[XIC(Reset_Edge)OTE(K1K2_Reset);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[ROUT(K1K2_Main,NEGATIVE,Zone_Robot_OK,Local:3:I.Pt00Data,Local:3:I.Pt00Data,K1K2_Reset)[XIC(K1K2_Main.O1) OTE(Local:2:O.Pt00Data) ,XIC(K1K2_Main.O2) OTE(Local:2:O.Pt01Data) ];]]></Text></Rung>
<Rung Number="2" Type="N"><Comment><![CDATA[Press safety valve -Y1/-Y2]]></Comment><Text><![CDATA[CROUT(Valve_Press,NEGATIVE,100,Zone_Press_OK,Local:3:I.Pt01Data,Local:3:I.Pt02Data,1,1,Reset_Edge)[XIC(Valve_Press.O1) OTE(Local:2:O.Pt02Data) ,XIC(Valve_Press.O2) OTE(Local:2:O.Pt03Data) ];]]></Text></Rung>
<Rung Number="3" Type="N"><Comment><![CDATA[Robot drive STO]]></Comment><Text><![CDATA[XIC(Robot_Drive:SO.SafeTorqueOff)XIC(Robot_Drive:SI.TorqueDisabled)XIC(Robot_Drive:SI.ResetRequired)OTE(Robot_Drive:SO.Reset);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[[XIC(Reset_Edge) ,XIC(Robot_Drive:SO.SafeTorqueOff) ]XIC(Cell_OK)XIO(Robot_Drive:SI.ConnectionFaulted)OTE(Robot_Drive:SO.SafeTorqueOff);]]></Text></Rung>
<Rung Number="5" Type="N"><Comment><![CDATA[Press drive - SS1 via off-delay timer]]></Comment><Text><![CDATA[XIC(Zone_Press_OK)TOF(Press_SS1,2000,0);]]></Text></Rung>
<Rung Number="6" Type="N"><Text><![CDATA[XIC(Press_SS1.DN)XIC(Local:1:I.Pt06Data)OTE(Press_Drive:SO.SafeTorqueOff);]]></Text></Rung>
<Rung Number="7" Type="N"><Comment><![CDATA[Guard lock release and service enable]]></Comment><Text><![CDATA[[XIC(Safety_FromStd[0].4) XIC(Local:3:I.Pt03Data) ,XIC(Safety_FromStd[0].5) ]OTE(Local:2:O.Pt04Data);]]></Text></Rung>
<Rung Number="8" Type="N"><Text><![CDATA[XIC(EStop_Panel.O1)[XIC(Door_Robot.O1) ,XIC(LC_Infeed.O1) ]OTE(Local:2:O.Pt05Data);]]></Text></Rung>
<Rung Number="9" Type="N"><Comment><![CDATA[Status to standard control]]></Comment><Text><![CDATA[XIC(Zone_Robot_OK)OTE(Safety_ToStd[0].0);]]></Text></Rung>
</RLLContent></Routine>
<Routine Name="Old_Logic" Type="RLL"><RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[XIC(EStop_Panel.O1)OTE(Old_Unused);]]></Text></Rung>
</RLLContent></Routine>
</Routines></Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Rate="10" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false" Class="Standard">
<ScheduledPrograms><ScheduledProgram Name="MainProgram"/></ScheduledPrograms></Task>
<Task Name="SafetyTask" Type="PERIODIC" Rate="20" Priority="10" Watchdog="20" DisableUpdateOutputs="false" InhibitTask="false" Class="Safety">
<ScheduledPrograms><ScheduledProgram Name="SafetyProgram"/></ScheduledPrograms></Task>
</Tasks>
